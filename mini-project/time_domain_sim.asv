% will be used for time domain simulation:

% include other script
find_param

N = fs; % idk, seems like an ok number to choose

% impulse input
x = [1; zeros(N-1, 1)];
y = x;

% each column corresponds to a filter
displacement = zeros(N, n);
pressure = zeros(N, n);

for i = 1:n
    b = coeff(i, Gz_idx) * [1, -coeff(i, a1_idx), coeff(i, a2_idx)];

    a = [1, -coeff(i, b1_idx), coeff(i, b2_idx)];

    % displacement:
    y = filter(coeff(i, Gp_idx), a, y);
    displacement(:, i) = y;

    % pressure:
    y = filter(b, 1, y);
    pressure(:, i) = y;
end

% spatial differentiation
spatial_diff1 = zeros(N, n-1);
spatial_diff2 = zeros(N, n-2);

for i = 1:n-1
    spatial_diff1(:, i) = displacement(:, i) - displacement(:, i+1);
end

for i = 1:n-2
    spatial_diff2(:, i) = spatial_diff1(:, i) - spatial_diff1(:, i+1);
end

% FFT of impulse responses
Y_disp = fft(displacement);
Y_disp1 = fft(spatial_diff1);
Y_disp2 = fft(spatial_diff2);

Y_press = fft(pressure);

% plotting
% plot_impulse(displacement, 88, 500);
% plot_impulse(spatial_diff2, 226, 5000);

% plot_fft(Y_disp, 192, fs);
% plot_fft(Y_disp1, 192, fs);
% plot_fft(Y_disp2, 192, fs);


% functions

function plot_impulse(matrix, section, samples)
    figure;
    plot(1:samples, matrix(1:samples, section));
    xlabel('Sample Number');
    ylabel('Amplitude');
end

% unit 1kHZ sin input
function plot_sim(matrix, section, samples)
    x = 1:samples
    y = sin(x * )

    figure;
    plot(1:samples, matrix(1:samples, section));
    xlabel('Sample Number');
    ylabel('Amplitude');
end

function plot_fft(matrix, section, fs)
    N = size(matrix, 1);

    f = (0:floor(N/2)) * fs / N;
    mag = abs(matrix(1:length(f), section));

    figure;
    semilogx(f(2:end), 20*log10(max(mag(2:end), eps)));

    xlim([10 fs/2]);
    xlabel('Frequency (Hz)');
    ylabel('Magnitude (dB)');
end

function num = freq_to_num(freq)
    x = log10(freq / 7500) / -0.667;
    num = round(x / 0.00684) + 1;
end